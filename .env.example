# Supabase (Project Settings → API). The anon key is public and protected by Row Level Security.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional: Cloudflare Turnstile site key for the "I'm human" check on sign-up / log-in / password reset.
# Add this BEFORE turning on CAPTCHA in Supabase (Authentication → Attack Protection).
VITE_TURNSTILE_SITE_KEY=

# Local preview only: run with fake browser data. Never set this on the live site.
# VITE_DEMO=true
